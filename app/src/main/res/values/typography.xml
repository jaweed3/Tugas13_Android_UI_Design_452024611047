<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TextAppearance.Tugas13.DisplaySmall" parent="TextAppearance.AppCompat.Display1">
        <item name="android:textSize">36sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Tugas13.HeadlineSmall" parent="TextAppearance.AppCompat.Headline5">
        <item name="android:textSize">24sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Tugas13.TitleLarge" parent="TextAppearance.AppCompat.Title">
        <item name="android:textSize">22sp</item>
